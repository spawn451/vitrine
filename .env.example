# /var/www/vitrine/.env — lu par systemd (EnvironmentFile). Droits 0640 vitrine:www-data.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=<64 caractères aléatoires : python -c "import secrets; print(secrets.token_urlsafe(48))">
ALLOWED_HOST=gemlogic.lovelyhome.io
GUNICORN_WORKERS=2

# PostgreSQL local
DATABASE_NAME=vitrine
DATABASE_USER=vitrine
DATABASE_PASSWORD=<mot de passe du rôle vitrine>
DATABASE_HOST=127.0.0.1

# Plateforme : domaine des espaces, code reçu par les nouveaux inscrits (jamais « le dernier tag »)
PLATFORM_DOMAIN=lovelyhome.io
APP_REPO=git@github.com:spawn451/temoin.git
APP_VERSION=v1.0.0
APP_WORKERS=2

# AWX : utilisateur dédié « vitrine », droit Exécuter sur le seul workflow onboard-client
AWX_URL=https://awx.example.lan
AWX_TOKEN=<jeton personnel de l'utilisateur vitrine, portée write>
AWX_ONBOARD_WORKFLOW_ID=<id du modèle de workflow onboard-client, visible dans son URL>
AWX_VERIFY_SSL=true
# Même valeur dans l'en-tête X-Vitrine-Secret de la notification webhook AWX
AWX_CALLBACK_SECRET=<32 caractères aléatoires>
AWX_POLL_AFTER_SECONDS=60

# Jeton de première connexion : même clé que vault_sso_key dans plateforme
SSO_KEY=<48 caractères aléatoires>

# E-mails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=GemLogic <no-reply@lovelyhome.io>
OPERATOR_EMAIL=<vous : reçoit les échecs de workflow>
RESERVATION_HOURS=24
