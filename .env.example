# /var/www/vitrine/.env — lu par systemd (EnvironmentFile) et deploy/manage.sh.
# Droits 0640 vitrine:www-data. Remplacer CHAQUE valeur <...> ; une valeur qui
# contient un espace ou un caractère spécial se met entre guillemets doubles.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=<sortie de : openssl rand -base64 48>
ALLOWED_HOST=gemlogic.lovelyhome.io
GUNICORN_WORKERS=2

# PostgreSQL local
DATABASE_NAME=vitrine
DATABASE_USER=vitrine
DATABASE_PASSWORD="<mot de passe du rôle vitrine, choisi au CREATE ROLE>"
DATABASE_HOST=127.0.0.1

# Plateforme : domaine des espaces, code reçu par les nouveaux inscrits (jamais « le dernier tag »)
PLATFORM_DOMAIN=lovelyhome.io
APP_REPO=git@github.com:spawn451/temoin.git
APP_VERSION=v1.0.0
APP_WORKERS=2

# AWX : utilisateur dédié « vitrine », droit Exécuter sur le seul workflow onboard-client
AWX_URL=<adresse d'AWX telle que tapée dans le navigateur, sans / final>
AWX_TOKEN=<jeton personnel de l'utilisateur vitrine, portée Écriture>
AWX_ONBOARD_WORKFLOW_ID=<nombre dans l'URL du modèle de workflow onboard-client>
AWX_VERIFY_SSL=true
# Même valeur dans l'en-tête X-Vitrine-Secret de la notification webhook AWX
AWX_CALLBACK_SECRET=<sortie de : openssl rand -base64 24>
AWX_POLL_AFTER_SECONDS=60

# Jeton de première connexion : la valeur EN CLAIR de vault_sso_key (plateforme), pas le bloc $ANSIBLE_VAULT
SSO_KEY=<la chaîne notée en générant vault_sso_key>

# E-mails. EMAIL_MODE=smtp envoie ; EMAIL_MODE=fichier n'envoie rien et écrit chaque
# e-mail dans /var/www/vitrine/mails/ (test sans fournisseur : le lien de confirmation
# se lit dans le fichier). En mode fichier, les EMAIL_HOST* sont ignorés.
EMAIL_MODE=smtp
EMAIL_HOST=<serveur SMTP, ex. smtp.office365.com>
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="GemLogic <no-reply@lovelyhome.io>"
OPERATOR_EMAIL=<votre adresse : reçoit les échecs de workflow>
RESERVATION_HOURS=24
